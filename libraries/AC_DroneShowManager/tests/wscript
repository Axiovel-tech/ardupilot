#!/usr/bin/env python3

# The .gdmb reader is plain C and has no dependency on the rest of the drone
# show manager (which is a Copter-only library), so the test compiles it
# directly instead of linking the vehicle library. The golden samples are
# binary64 literals, so the test is built without -fsingle-precision-constant.

import ardupilotwaf

def build(bld):
    if not bld.env.HAS_GTEST:
        return

    features = []
    if bld.cmd == 'check':
        features.append('test')

    t = bld.ap_program(
        features=features,
        includes=[bld.srcnode.abspath() + '/tests/'],
        source=['test_gdmb.cpp', '../DroneShow_Gdmb.c'],
        use=['ap', 'GTEST'],
        program_name='test_gdmb',
        program_groups='tests',
        use_legacy_defines=False,
        vehicle_binary=False,
        cxxflags=['-Wno-undef'],
    )
    t.env.CXXFLAGS = ardupilotwaf.set_double_precision_flags(t.env.CXXFLAGS)
